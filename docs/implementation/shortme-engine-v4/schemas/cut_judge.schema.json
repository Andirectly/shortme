{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "V4 Local Cut Judge",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "startEdgeId",
    "endEdgeId",
    "preferred",
    "criteria",
    "reasonCode"
  ],
  "properties": {
    "startEdgeId": {
      "type": "string",
      "minLength": 1
    },
    "endEdgeId": {
      "type": "string",
      "minLength": 1
    },
    "preferred": {
      "type": "boolean"
    },
    "reasonCode": {
      "type": "string",
      "minLength": 1
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "state",
          "reason",
          "evidenceIds"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "state": {
            "enum": [
              "pass",
              "fail",
              "unknown"
            ]
          },
          "reason": {
            "type": "string"
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
