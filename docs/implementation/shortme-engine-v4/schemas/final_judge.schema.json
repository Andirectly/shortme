{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "V4 Rendered Artifact Judge",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "variantId",
    "outputSha256",
    "evaluatedRenderedOutput",
    "criteria",
    "decision"
  ],
  "properties": {
    "variantId": {
      "type": "string",
      "minLength": 1
    },
    "outputSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evaluatedRenderedOutput": {
      "const": true
    },
    "decision": {
      "enum": [
        "acceptable",
        "needs-review",
        "reject"
      ]
    },
    "criteria": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "required": [
          "id",
          "state",
          "reason",
          "evidenceIds"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "enum": [
              "hook",
              "standalone",
              "payoff",
              "natural-end",
              "audio-seam",
              "visual-seam",
              "essential-event",
              "caption-sync",
              "crop-safety",
              "dead-air"
            ]
          },
          "state": {
            "enum": [
              "pass",
              "fail",
              "unknown",
              "not-applicable"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "maxItems": 10,
      "allOf": [
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "hook"
              }
            },
            "required": [
              "id"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "standalone"
              }
            },
            "required": [
              "id"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "payoff"
              }
            },
            "required": [
              "id"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "natural-end"
              }
            },
            "required": [
              "id"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "audio-seam"
              }
            },
            "required": [
              "id"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "visual-seam"
              }
            },
            "required": [
              "id"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "essential-event"
              }
            },
            "required": [
              "id"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "caption-sync"
              }
            },
            "required": [
              "id"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "crop-safety"
              }
            },
            "required": [
              "id"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "dead-air"
              }
            },
            "required": [
              "id"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    }
  }
}
