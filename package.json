{
  "name": "cutawan",
  "version": "0.28.0",
  "description": "Shortme – lokale Windows-App: lange Videos zu kurzen vertikalen Clips",
  "main": "out/main/index.js",
  "author": "Shortme",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "test": "vitest run",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "quality:benchmark": "tsx --tsconfig tsconfig.node.json scripts/quality-benchmark.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "start": "electron-vite preview",
    "package": "npm run remotion:bundle && electron-vite build && electron-builder",
    "release": "node scripts/release.mjs",
    "package:dir":"npm run remotion:bundle && electron-vite build && electron-builder --dir",
    "remotion:bundle": "node captions-remotion/bundle.cjs resources/remotion-bundle"
  },
  "dependencies": {
    "@ffprobe-installer/ffprobe": "2.1.2",
    "@remotion/renderer": "4.0.536",
    "@tscaps/engine": "^0.7.0",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.2.0",
    "motion": "^14.3.0",
    "onnxruntime-node": "^1.27.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "4.0.536",
    "sherpa-onnx-node": "^1.13.8",
    "sherpa-onnx-win-x64": "^1.13.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@remotion/bundler": "4.0.536",
    "@remotion/player": "4.0.536",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "js-yaml": "^4.3.0",
    "lucide-react": "^0.487.0",
    "rcedit": "^5.0.2",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.62.1",
    "vite": "^6.2.0",
    "vitest": "^4.1.9",
    "zustand": "^5.0.3"
  },
  "build": {
    "appId": "local.shortme.app",
    "productName": "Shortme",
    "icon": "build/icon.png",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Andirectly",
        "repo": "shortme"
      }
    ],
    "files": [
      "out/**"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/@ffprobe-installer/**",
      "node_modules/onnxruntime-node/**",
      "node_modules/sherpa-onnx-node/**",
      "node_modules/sherpa-onnx-win-x64/**",
      "out/main/asrWorker.js",
      "out/main/chunks/**",
      "node_modules/@remotion/compositor-win32-x64-msvc/**"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "resources/models",
        "to": "models"
      },
      {
        "from": "resources/prompts",
        "to": "prompts"
      },
      {
        "from": "resources/profiles",
        "to": "profiles"
      },
      {
        "from": "resources/fonts",
        "to": "fonts"
      },
      {
        "from": "resources/yt-dlp-plugins",
        "to": "yt-dlp-plugins"
      },
      {
        "from": "resources/models-catalog.json",
        "to": "models-catalog.json"
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "resources/remotion-bundle",
        "to": "remotion-bundle"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false,
      "icon": "build/icon.ico"
    },
    "nsis": {
      "artifactName": "Shortme-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "afterPack": "scripts/afterPack.cjs"
  }
}
